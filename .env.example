# =============================================================================
# CAMPUSINTEL CLOUD RAG - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# --- CLOUD LLM PROVIDER CONFIGURATION ---
# Active Provider: anthropic | aws_bedrock | gcp_vertex | openrouter
LLM_PROVIDER=anthropic

# Anthropic Direct API
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# AWS Bedrock Claude Integration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Google Cloud Vertex AI Claude
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_MODEL_ID=claude-3-5-sonnet@20240620

# --- CLOUD VECTOR DATABASE CONFIGURATION ---
# Active Provider: chroma_local | chroma_cloud | qdrant_cloud | pinecone
VECTOR_DB_PROVIDER=chroma_local

# Qdrant Cloud Cluster Settings
QDRANT_URL=https://your-cluster-url.qdrant.tech:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=college_regulations

# Pinecone Serverless Settings
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=college-rag-assistant

# --- CLOUD EMBEDDINGS CONFIGURATION ---
# Provider: fastembed | voyage | cohere | bedrock_titan | openai
EMBEDDING_PROVIDER=fastembed
VOYAGE_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=

# --- SCALABILITY & SEMANTIC CACHING ---
ENABLE_SEMANTIC_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400
REDIS_URL=redis://localhost:6379/0
